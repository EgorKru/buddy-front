{
  "name": "pager-front",
  "version": "1.0.0",
  "private": true,
  "description": "Pager - платформа для видеозвонков и мессенджера. Первая стабильная MVP версия.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:report": "next lint > eslint-report.txt 2>&1",
    "audit:deps": "npm list --depth=0",
    "audit:depcheck": "npx depcheck",
    "audit:bundle": "npm run build && npx source-map-explorer .next/static/chunks/*.js --html docs/bundle-report.html",
    "find-deadcode": "npx unimported",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "jest",
    "test:ci": "jest --ci --forceExit --coverage --coverageDirectory=coverage --coverageReporters=lcov --coverageReporters=json-summary --json --outputFile=coverage/jest-results.json",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:setup": "node scripts/e2e-setup.mjs",
    "test:e2e:realtime": "node scripts/run-e2e-realtime.mjs",
    "test:e2e:call": "node scripts/run-e2e-call.mjs",
    "test:e2e:meet": "node scripts/run-e2e-meet.mjs",
    "test:e2e:files": "node scripts/run-e2e-files.mjs",
    "test:e2e:media": "node scripts/run-e2e-media.mjs",
    "test:e2e:reply": "node scripts/run-e2e-reply.mjs",
    "test:files": "jest --testPathPattern=\"(FileMessage|FileViewerModal|fetchChatFileBlob)\"",
    "test:realtime": "jest --testPathPattern=\"(messagingReducer|messagingUpsert|messagingMarkRead|messagingReply|readMeta|ChatListItem|realtime|useChatRealtime|useMessageSender|replyTo|useTypingIndicator|typingUsersState|TypingIndicator)\"",
    "test:reply": "jest --testPathPattern=\"(replyTo|messagingReply|useMessageSender.reply|useChatRealtime|ReplyMessage)\"",
    "test:call": "jest --testPathPattern=\"useCallProtocol\"",
    "test:meet": "jest --testPathPattern=\"useRoomProtocol\"",
    "test:realtime:all": "npm run test:realtime && npm run test:ws-smoke && npm run test:e2e:realtime",
    "test:call:all": "npm run test:call && npm run test:call-smoke && npm run test:e2e:call",
    "test:meet:all": "npm run test:meet && npm run test:room-smoke && npm run test:e2e:meet",
    "test:room-smoke": "node scripts/room-smoke.mjs",
    "test:ws-smoke": "node scripts/ws-smoke.mjs",
    "test:call-smoke": "node scripts/call-smoke.mjs",
    "test:media": "jest --testPathPattern=\"shared/lib/media\"",
    "test:media:all": "npm run test:media && npm run test:media-smoke && npm run test:e2e:media",
    "test:media-smoke": "node scripts/media-smoke.mjs"
  },
  "dependencies": {
    "@stomp/stompjs": "^7.2.1",
    "classnames": "^2.3.2",
    "lucide-react": "^0.294.0",
    "next": "13.5.6",
    "peerjs": "^1.5.1",
    "react": "^18",
    "react-copy-to-clipboard": "^5.1.0",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "autoprefixer": "^10",
    "babel-jest": "^29.7.0",
    "eslint": "^8",
    "eslint-config-next": "13.5.6",
    "eslint-config-prettier": "^9.1.2",
    "fake-indexeddb": "^5.0.2",
    "husky": "^9.0.11",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.2.2",
    "postcss": "^8",
    "postcss-import": "^16.1.0",
    "postcss-nesting": "^12.0.1",
    "prettier": "^3.2.5",
    "tailwindcss": "^3"
  }
}

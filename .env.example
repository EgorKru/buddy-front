# API Configuration
# Р”Р»СЏ СЂР°Р·СЂР°Р±РѕС‚РєРё СЃ production СЃРµСЂРІРµСЂРѕРј РёСЃРїРѕР»СЊР·СѓР№С‚Рµ:
# NEXT_PUBLIC_API_URL=https://pager.website/api
# NEXT_PUBLIC_WS_URL=https://pager.website/ws

# Р”Р»СЏ Р»РѕРєР°Р»СЊРЅРѕР№ СЂР°Р·СЂР°Р±РѕС‚РєРё РёСЃРїРѕР»СЊР·СѓР№С‚Рµ:
# NEXT_PUBLIC_API_URL=http://localhost:8080/api
# NEXT_PUBLIC_WS_URL=http://localhost:8080/ws

# РћРїС†РёРѕРЅР°Р»СЊРЅРѕ: РµСЃР»Рё С‚РѕРєРµРЅ РЅРµ РїРµСЂРµРґР°РµС‚СЃСЏ С‡РµСЂРµР· Р·Р°РіРѕР»РѕРІРєРё, РёСЃРїРѕР»СЊР·СѓР№С‚Рµ:
# NEXT_PUBLIC_WS_TOKEN_IN_URL=true (С‚РѕРіРґР° С‚РѕРєРµРЅ Р±СѓРґРµС‚ РІ query РїР°СЂР°РјРµС‚СЂРµ)

NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_WS_URL=http://localhost:8080/ws

# Сквозное шифрование текста в личных (DIRECT) чатах: ECDH P-256 + AES-GCM в браузере.
# Нужен бэкенд с /api/crypto/* и полем encryptionVersion у сообщений.
# Не распространяется на групповые чаты и на вложения/медиа (только TEXT).
# NEXT_PUBLIC_E2EE_ENABLED=true
